# Copy to .env and fill in real values.
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Only set to "true" against a plain local/CI Postgres that doesn't speak TLS
# (e.g. the postgres: service container in CI). Never set this for Supabase
# or any other TLS-only host — leave unset in normal dev.
PGSSL_DISABLE="false"

AUTH_SECRET="change-me-32-chars-minimum"
APP_URL="http://localhost:3000"

# Resend — leave unset to keep email logged instead of delivered. Get an API
# key at resend.com; RESEND_FROM_EMAIL must be on a domain you've verified there.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Razorpay — leave unset to keep bookings on the mock provider (synchronous,
# no real charge). Set all three to switch real bookings over to Razorpay;
# get keys from the Razorpay dashboard, webhook secret from the webhook you
# configure there pointing at APP_URL + /api/payments/webhook/razorpay.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Off by default. Only set to "true" in a throwaway demo/sandbox deployment —
# with it on, /admin and /stakeholder fall back to the first seeded user when
# no one is signed in. Never enable this on anything reachable by the public.
ALLOW_DEMO_FALLBACK="false"

REDIS_URL="redis://redis:6379"

S3_ENDPOINT="http://minio:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="limekraft"
S3_SECRET_KEY="limekraft-dev-secret"
S3_BUCKET="lime-kraft-media"
S3_REGION="us-east-1"

# Airbnb Partner API — only usable once Airbnb approves partner/channel-manager
# access; there's no public self-serve signup. Leave unset until then.
AIRBNB_API_KEY=""
AIRBNB_API_BASE_URL=""

NEXT_PUBLIC_APP_NAME="Lime Kraft Home Stays"
# NODE_ENV is set by the tooling (`next dev` -> development, `next build` ->
# production). Do not set it here: a hardcoded value is picked up by
# `next build` too, which ships a development React into production and
# breaks the prerender of the global error page.
