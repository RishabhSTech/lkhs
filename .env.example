# Copy to .env and fill in real values.
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Only set to "true" against a plain local/CI Postgres that doesn't speak TLS
# (e.g. the postgres: service container in CI). Never set this for Supabase
# or any other TLS-only host - leave unset in normal dev.
PGSSL_DISABLE="false"

AUTH_SECRET="change-me-32-chars-minimum"
APP_URL="http://localhost:3000"

# SMTP - the real sender for every system email the site sends (OTP codes,
# booking confirmations, team alerts): no-reply@limekraftstays.com on
# Hostinger. Takes priority over Resend below when set. Leave any of these
# four unset to keep email logged instead of delivered.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="no-reply@limekraftstays.com"
SMTP_PASSWORD=""
# Defaults to SMTP_USER if unset - only set this if the From: address should
# differ from the login account.
SMTP_FROM_EMAIL=""

# Resend - alternative to SMTP above; only used if SMTP_HOST isn't set. Get
# an API key at resend.com; RESEND_FROM_EMAIL must be on a domain you've
# verified there.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Razorpay - leave unset to keep bookings on the mock provider (synchronous,
# no real charge). Set all three to switch real bookings over to Razorpay;
# get keys from the Razorpay dashboard, webhook secret from the webhook you
# configure there pointing at APP_URL + /api/payments/webhook/razorpay.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Off by default. Only set to "true" in a throwaway demo/sandbox deployment -
# with it on, /admin and /stakeholder fall back to the first seeded user when
# no one is signed in. Never enable this on anything reachable by the public.
ALLOW_DEMO_FALLBACK="false"

REDIS_URL="redis://redis:6379"

S3_ENDPOINT="http://minio:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="limekraft"
S3_SECRET_KEY="limekraft-dev-secret"
S3_BUCKET="lime-kraft-media"
S3_REGION="us-east-1"

# Airbnb Partner API - only usable once Airbnb approves partner/channel-manager
# access; there's no public self-serve signup. Leave unset until then.
AIRBNB_API_KEY=""
AIRBNB_API_BASE_URL=""

# Web push (instant "new inquiry" alerts to the team, no third-party account
# needed). Generate a pair with `npx web-push generate-vapid-keys` and paste
# both below - the public one is also exposed to the browser.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact URL/mailto the push service can reach you on if it flags your usage.
VAPID_SUBJECT="mailto:ops@example.com"
# Same value as VAPID_PUBLIC_KEY above - duplicated because only NEXT_PUBLIC_*
# vars reach the browser, and dotenv doesn't expand ${...} references.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Where the instant email backup alert for new inquiries is sent (in addition
# to push). Only delivers once SMTP or Resend is also configured above;
# otherwise logged.
TEAM_ALERT_EMAIL=""

# Shared secret a future channel-manager (Beds24, Hostaway, etc.) webhook must
# send as `x-webhook-secret` to post Airbnb/Booking.com/Agoda messages into
# the unified inbox. Generate any random string; leave unset to reject all
# webhook calls.
CHANNEL_WEBHOOK_SECRET=""

# Anthropic API key for the guest-facing AI chatbot (src/app/api/chat) and
# for extracting structured booking info from parsed OTA emails
# (src/lib/mailbox/extract-booking-info.ts). Get one at console.anthropic.com.
# Leave unset and the chatbot tells guests to use the contact form instead,
# and mailbox email parsing fails loudly rather than guessing.
ANTHROPIC_API_KEY=""

# 32-byte key (any string works - it's run through scrypt) used to encrypt
# the homestay@ mailbox password at rest (src/lib/mailbox/crypto.ts).
# Hostinger/Titan mail is plain IMAP with no OAuth alternative, so unlike a
# Gmail/Google integration this really is the account password - connect it
# from Settings → Integrations, not via an env var. Generate this key with:
# openssl rand -base64 32
ENCRYPTION_KEY=""

NEXT_PUBLIC_APP_NAME="Lime Kraft Home Stays"
# NODE_ENV is set by the tooling (`next dev` -> development, `next build` ->
# production). Do not set it here: a hardcoded value is picked up by
# `next build` too, which ships a development React into production and
# breaks the prerender of the global error page.
